# ── 使用说明 ──────────────────────────────────────────
# 1. 填上自己的 DeepSeek API Key
# 2. 复制本文件为 .env（重命名为 .env 即可）
#
# 示例：将下面 DEEPSEEK_API_KEY 的值换成你的真实 Key
# ─────────────────────────────────────────────────────

# ── DeepSeek API（必填） ──────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── GitHub Token（可选，用于 MCP 工具） ───────────────
# GITHUB_TOKEN=ghp_your_github_token_here
